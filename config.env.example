# Copy this file to config.env and adjust the values for your GCP setup.
#   cp config.env.example config.env
# config.env is git-ignored so your project-specific values stay local.

# GCP project that owns the VM
PROJECT_ID="my-gcp-project"

# Compute Engine instance name
INSTANCE_NAME="i2i-cloud-vm"

# Region/zone the VM runs in
ZONE="europe-west1-b"

# Machine type (e2-micro is covered by the GCP free tier)
MACHINE_TYPE="e2-micro"

# Base image for the VM
IMAGE_FAMILY="debian-12"
IMAGE_PROJECT="debian-cloud"

# Public IP of the VM, filled in after provisioning (used by the ping test)
VM_PUBLIC_IP=""
